# RPC for the dashboard and the keeper. Locally — the validator in WSL, publicly — devnet.
RPC_URL=http://127.0.0.1:8899

# Program id. The real one appears after the first `anchor build` (target/deploy).
PROGRAM_ID=

# --- apps/keeper ---
# The market the keeper settles and rolls in; it serves every ladder there with policy=Roll.
KEEPER_MARKET=
# Keeper wallet. Pays only for gas and the rent of rolled rungs, and has no access to treasury
# funds. Exactly one of the two: a file path locally, the JSON array itself as a CI secret.
KEEPER_KEYPAIR_PATH=
KEEPER_KEYPAIR=
# Optional: seconds between ticks in loop mode (default 60) and the balance below which the
# keeper refuses to send anything (default 50000000 lamports = 0.05 SOL).
KEEPER_INTERVAL_SECONDS=
KEEPER_MIN_BALANCE_LAMPORTS=

# --- apps/web ---
# Vite exposes only variables prefixed with VITE_ to the browser. Without VITE_RPC_URL
# the dashboard stays an M0 prototype on mock data and says so in its status bar.
VITE_RPC_URL=http://127.0.0.1:8899
# Optional: without it the address comes from the IDL (packages/sdk/src/idl).
VITE_PROGRAM_ID=
# The market the dashboard shows. Without it the network is read but there are no prices:
# the fee, the rung minimum and the mint live in Market.
VITE_MARKET=
