# Peer dependencies are not installed automatically: every package that imports code
# declares it explicitly in its own package.json. The reason is not tidiness but cost —
# @solana-mobile/mobile-wallet-adapter-protocol declares react-native as a required
# peer, and pnpm pulls in 253 packages, none of which ever runs in the treasurer's
# browser. peerDependencyRules.ignoreMissing does not cure this:
# it silences the warning, not the installation.
auto-install-peers=false
